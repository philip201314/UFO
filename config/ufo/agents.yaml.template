# UFO Agent Configurations - 通过 LLM Nexus 代理使用视觉模型
# ⚠️ 依赖 LLM Nexus 代理运行在 127.0.0.1:19090
#
# 使用方法:
#   1. 复制此文件为 agents.yaml
#   2. 如果不使用 LLM Nexus 代理，需要填入 API_KEY 和修改 API_BASE
#   3. 确保 LLM Nexus 代理运行在 127.0.0.1:19090

HOST_AGENT:
  VISUAL_MODE: True  # 关键！必须开启视觉模式
  REASONING_MODEL: False
  API_TYPE: "openai"  # 通过 LLM Nexus 代理（OpenAI 兼容格式）
  API_BASE: "http://127.0.0.1:19090/v1"  # LLM Nexus 代理地址
  API_KEY: "not-needed"  # LLM Nexus 代理不需要认证
  API_VERSION: "2025-02-01-preview"
  API_MODEL: "bailian:qwen3.5-plus"  # 百炼视觉+文本模型
  PROMPT: "ufo/prompts/share/base/host_agent.yaml"
  EXAMPLE_PROMPT: "ufo/prompts/examples/{mode}/host_agent_example.yaml"

APP_AGENT:
  VISUAL_MODE: True  # 关键！AppAgent 必须看到截图才能操作
  REASONING_MODEL: False
  API_TYPE: "openai"
  API_BASE: "http://127.0.0.1:19090/v1"
  API_KEY: "not-needed"
  API_VERSION: "2025-02-01-preview"
  API_MODEL: "bailian:qwen3.5-plus"
  PROMPT: "ufo/prompts/share/base/app_agent.yaml"
  EXAMPLE_PROMPT: "ufo/prompts/examples/{mode}/app_agent_example.yaml"
  EXAMPLE_PROMPT_AS: "ufo/prompts/examples/{mode}/app_agent_example_as.yaml"

BACKUP_AGENT:
  VISUAL_MODE: True
  API_TYPE: "openai"
  API_BASE: "http://127.0.0.1:19090/v1"
  API_KEY: "not-needed"
  API_VERSION: "2024-02-15-preview"
  API_MODEL: "bailian:qwen3-max-2026-01-23"

EVALUATION_AGENT:
  VISUAL_MODE: True
  REASONING_MODEL: False
  API_TYPE: "openai"
  API_BASE: "http://127.0.0.1:19090/v1"
  API_KEY: "not-needed"
  API_VERSION: "2025-02-01-preview"
  API_MODEL: "bailian:qwen3.5-plus"
